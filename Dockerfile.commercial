# Standalone, authenticated COMVERXA Commercial pilot. Not the live COMVERXA CRM.
FROM node:22-alpine
WORKDIR /app
COPY backend/commercial-premium-core.mjs backend/
COPY backend/commercial-premium-team.mjs backend/
COPY backend/commercial-premium-tenants.mjs backend/
COPY backend/commercial-premium-leads.mjs backend/
COPY backend/commercial-premium-store.mjs backend/
COPY backend/commercial-premium-http.mjs backend/
COPY backend/commercial-premium-reports.mjs backend/
COPY backend/commercial-premium-server.mjs backend/
COPY backend/commercial-premium-offsite-backup.mjs backend/
COPY backend/commercial-premium-mail.mjs backend/
COPY backend/commercial-premium-launch.mjs backend/
COPY site/comverxa-premium-operacional.html site/
COPY site/comverxa-premium-operacional.js site/
COPY site/comverxa-premium-login.js site/
COPY site/comverxa-premium-recovery.js site/
COPY site/comverxa-premium-recovery.html site/
ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000
CMD ["node","backend/commercial-premium-launch.mjs"]
